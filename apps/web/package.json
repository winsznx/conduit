{
  "name": "@conduit-protocol/app-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Settlement console, public proof pages, and operator UI.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "bundle": "esbuild src/worker.ts --bundle --format=esm --platform=neutral --conditions=workerd,worker,import,module,default --target=es2022 --external:node:* --external:cloudflare:* --outfile=dist/worker.bundle.js",
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "postgres": "3.4.9"
  }
}
