{
  // The browser half. It needs the DOM lib; the Worker half must not have it,
  // which is why these are two projects rather than one loosened one.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  // `actions.ts` and `onchain.ts` live one level up because the Worker uses them
  // too. One resolver and one set of ABIs, shared, rather than two that drift.
  "include": ["**/*.ts", "../actions.ts", "../onchain.ts"]
}
