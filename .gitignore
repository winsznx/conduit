# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
cache/
cache_forge/
broadcast/*/dry-run/
*.tsbuildinfo
.tsbuild/

# test output
coverage/
lcov.info
playwright-report/
test-results/
