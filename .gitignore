# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
cache/
cache_forge/
broadcast/*/dry-run/
*.tsbuildinfo
.tsbuild/

# test output
coverage/
lcov.info
playwright-report/
test-results/
.vitest/

# runtime secrets — never commit
.env
.env.*
!.env.example

# local tooling
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json

# terraform local state
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.local

# generated evidence artifacts are content-addressed and published, not committed raw
docs/evidence/artifacts/
.scratch/

# Private working material: the brand-design skill and similar notes. Never committed.
/internal/

# Cloudflare Workers local secrets. `wrangler dev` reads these and `wrangler
# secret put` writes them; either way the file holds live values and the moment
# it exists is the moment it can be staged. Ignored before it is created.
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*

# Wrangler's local build and dev cache. Regenerated on every run.
.wrangler/

# Visual QA screenshots. Regenerated by `playwright test --project=web-visual`.
qa/screens/
test-results/

# Generated by apps/web/build.mjs; the hash changes with every build.
apps/web/src/client.bundle.js.txt
apps/web/src/client-manifest.ts
apps/web/src/image-manifest.ts
apps/web/src/brand-manifest.ts

# A working document for recording the demo. It is not part of the repository.
/DEMO_SCRIPT.md
