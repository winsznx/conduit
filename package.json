{
  "name": "conduit",
  "version": "0.0.0",
  "private": true,
  "description": "Compliance-preserved cross-chain delivery-versus-payment protocol",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "conduit": "node --env-file-if-exists=.env packages/cli/dist/bin.js",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "format": "prettier --write . && forge fmt",
    "format:check": "prettier --check . && forge fmt --check",
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vvv",
    "contracts:invariant": "forge test --match-path 'contracts/test/invariant/**/*.t.sol'",
    "contracts:gas": "forge snapshot --check --tolerance 1",
    "contracts:layout": "node scripts/storage-layout.mjs --check",
    "security:slither": "slither . --config-file slither.config.json",
    "security:audit": "pnpm audit --audit-level moderate",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "manifest:check": "node scripts/check-deployment-manifests.mjs",
    "dvp:preflight": "node --env-file=.env scripts/dvp-preflight.mjs",
    "dvp:run": "node --env-file=.env scripts/run-dvp.mjs",
    "verify": "node scripts/verify.mjs",
    "clean": "rm -rf node_modules '**/node_modules' '**/dist' '**/*.tsbuildinfo' cache out coverage",
    "evidence:build": "node scripts/build-evidence-index.mjs && node scripts/build-evidence-manifest.mjs",
    "evidence:check": "node scripts/build-evidence-index.mjs --check && node scripts/build-evidence-manifest.mjs --check",
    "onchain:capture": "node scripts/check-onchain-verification.mjs",
    "onchain:check": "node scripts/check-onchain-verification.mjs --check",
    "onchain:index": "node scripts/build-onchain-index.mjs",
    "onchain:index:check": "node scripts/build-onchain-index.mjs --check",
    "hero:build": "node scripts/build-hero-image.mjs",
    "hero:check": "node scripts/build-hero-image.mjs --check"
  },
  "devDependencies": {
    "@conduit-protocol/app-api": "workspace:*",
    "@conduit-protocol/app-indexer": "workspace:*",
    "@conduit-protocol/app-web": "workspace:*",
    "@conduit-protocol/app-worker": "workspace:*",
    "@conduit-protocol/cleanverse": "workspace:*",
    "@conduit-protocol/cli": "workspace:*",
    "@conduit-protocol/config": "workspace:*",
    "@conduit-protocol/db": "workspace:*",
    "@conduit-protocol/domain": "workspace:*",
    "@conduit-protocol/observability": "workspace:*",
    "@conduit-protocol/sdk": "workspace:*",
    "@conduit-protocol/ui": "workspace:*",
    "@conduit-protocol/verifier": "workspace:*",
    "@conduit-protocol/wormhole": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.9.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "viem": "2.55.11",
    "vitest": "4.1.10"
  }
}
