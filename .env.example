# Conduit environment template.
#
# Names only. This file is committed, so it must never carry a value. The
# repository gate asserts that every assignment here is empty, and gitleaks
# scans both the worktree and the full git history on every commit.
#
# Copy to `.env` and fill it in. `.env` is gitignored and must stay that way.
#
#   cp .env.example .env
#
# Variables are grouped by the phase that introduces them. A variable appears
# here when code reads it, not when somebody guesses it might be needed later.
#
# Nothing in this file is a secret. Everything in your `.env` will be.

# ── runtime ─────────────────────────────────────────────────────────────────
# Defaults if unset: NODE_ENV=development, LOG_LEVEL=info.
NODE_ENV=
LOG_LEVEL=

# ── Cleanverse API V5.6 (PRD 9.1, phase 01) ─────────────────────────────────
# Server only. PRD 9.1 forbids the API key, a decrypted payload, a raw response
# carrying sensitive material, or webhook HMAC key material from ever reaching a
# browser bundle. Nothing under packages/cleanverse may be imported client side.
#
# The API key is base64 as Cleanverse distributes it. It must decode to 16, 24,
# or 32 bytes; packages/config rejects anything else at startup rather than at
# the first request.
#
# The base URL must be https, and it must be the real Cleanverse host. The AES
# layer encrypts the request body but authenticates nothing and identifies no
# endpoint, so TLS is what stops the credential reaching an attacker-controlled
# server. Never point this at a guessed hostname.
#
# Timeout defaults to 15000 ms and read retries to 2 if unset.
CLEANVERSE_BASE_URL=
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY_BASE64=
CLEANVERSE_REQUEST_TIMEOUT_MS=
CLEANVERSE_MAX_READ_RETRIES=

# ── chain RPC endpoints (phase 01) ──────────────────────────────────────────
# Read by `conduit doctor` and by the startup chain-ID assertion. CLAUDE.md
# requires chain IDs to be checked against the RPC before anything else runs,
# because an RPC pointed at the wrong network means a settlement signed for one
# chain is submitted to another.
#
# Expected: Monad Testnet reports 10143, Arbitrum Sepolia reports 421614.
# Public endpoints that work today:
#   https://testnet-rpc.monad.xyz
#   https://sepolia-rollup.arbitrum.io/rpc
#
# PRD 14.2 treats RPC providers as untrusted, so production reads use more than
# one provider and reconcile. A second provider per chain arrives in phase 06.
MONAD_TESTNET_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# ── deployment identities (phase 02 onward) ─────────────────────────────────
# PRD 8.2 and 17.4 require separated roles. No single key holds more than one,
# and no EOA holds all of them.
#
# Prefer a Foundry keystore account over a raw key. `cast wallet import` stores
# the key encrypted and `forge script --account <name>` uses it without the key
# ever entering a file this process can read:
#
#   cast wallet import conduit-deployer --interactive
#
# The raw-key variables below exist only for testnet convenience. PRD 17.4 is
# explicit that production keys never live in `.env`; they live in a KMS or in
# Cloudflare Worker secrets.
FOUNDRY_KEYSTORE_ACCOUNT=
DEPLOYER_PRIVATE_KEY=

# Gas only, no protocol authority. PRD FR-009 makes relaying permissionless and
# invariant I12 means a relayer cannot forge remote state, so losing this key
# costs gas and nothing else.
RELAYER_PRIVATE_KEY=

# Staging uses a single compliance signer. PRD 11.5 requires a 2-of-3 quorum in
# production with keys in separate KMS or HSM identities, and the UI and docs
# must mark the single-signer trust boundary wherever it applies.
COMPLIANCE_SIGNER_PRIVATE_KEY=

# ── block explorer verification (phase 02 onward) ───────────────────────────
ARBISCAN_API_KEY=
MONAD_EXPLORER_API_KEY=

# ── Cleanverse webhooks (phase 05) ──────────────────────────────────────────
# PRD 9.4: the HMAC is verified against the raw request bytes before any JSON
# parsing, and the delivery ID is the idempotency key.
CLEANVERSE_WEBHOOK_HMAC_KEY=

# ── Supabase (v1.1 override section 13, phase 06) ───────────────────────────
# Supabase is the managed PostgreSQL provider. The database stays a projection:
# invariant I11 means it can never authorize on-chain value movement, and the
# public verifier reaches a terminal answer with an empty local database.
#
# The service-role key never reaches browser code. That is threat V-09, and it
# is the single most damaging credential in this file.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare (v1.1 override section 13, phase 06 onward) ──────────────────
# Workers run the API and web runtime through @opennextjs/cloudflare, R2 stores
# evidence artifacts, and Queues carry at-least-once asynchronous work, so every
# consumer is idempotent.
#
# In a deployed Worker these are secret bindings rather than environment
# variables. They appear here for local development and for wrangler.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_EVIDENCE_BUCKET=

# ── OpenTelemetry (PRD 16, phase 06) ────────────────────────────────────────
# infra/docker runs a local collector on 4318. PRD 16.4 forbids private keys,
# the Cleanverse API key, raw PII, bank details, and decrypted Cleanverse
# payloads from reaching any exporter.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
