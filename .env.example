# Conduit environment template.
#
# Names only. This file is committed, so it must never carry a value — the
# repository gate asserts that every assignment here is empty, and gitleaks
# scans both the worktree and history.
#
# Variables appear here in the phase that introduces them. PRD 9.1 fixes the
# Cleanverse names; the rest are added as later phases define them.

# ─── runtime ──────────────────────────────────────────────────────────────
NODE_ENV=
LOG_LEVEL=

# ─── Cleanverse API V5.6 (PRD 9.1) — server only, never sent to a browser ──
CLEANVERSE_BASE_URL=
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY_BASE64=
CLEANVERSE_REQUEST_TIMEOUT_MS=
CLEANVERSE_MAX_READ_RETRIES=
