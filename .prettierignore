# build. Reformatting either makes the next regeneration a diff.
brand/manifest.json
scripts/brand/type.json

# Run artifacts are records, written by the scripts that produced the runs. A
# formatter has no business rewriting the bytes of a thing whose whole purpose
# is to be the record of what happened.
